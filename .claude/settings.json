{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(git diff:*)",
      "PowerShell(git diff:*)",
      "Bash(git log:*)",
      "PowerShell(git log:*)",
      "Bash(git status:*)",
      "PowerShell(git status:*)",
      "Bash(node:*)",
      "PowerShell(node:*)",
      "Bash(npm:*)",
      "PowerShell(npm:*)",
      "Bash(findstr:*)",
      "PowerShell(findstr:*)",
      "Bash(Select-String:*)",
      "PowerShell(Select-String:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "PowerShell(git push:*)",
      "Bash(git commit:*)",
      "PowerShell(git commit:*)",
      "Bash(rm:*)",
      "PowerShell(rm:*)",
      "Bash(Remove-Item:*)",
      "PowerShell(Remove-Item:*)"
    ]
  }
}
